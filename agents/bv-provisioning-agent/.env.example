# BV Provisioning Agent Environment Variables
# Copy this file to .env and fill in your actual values

# Anthropic API Configuration
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Salesforce Configuration
# Your Salesforce org username (usually your email)
SALESFORCE_ORG_USERNAME=your-email@broadvoice.com

# Your Salesforce org ID (18-character ID starting with 00D)
SALESFORCE_ORG_ID=your-salesforce-org-id-here

# Optional: Claude Model Configuration
# Defaults to claude-sonnet-4-5 if not specified
# CLAUDE_MODEL=claude-sonnet-4-5

# Optional: Model Parameters
# MAX_TOKENS=8192
# TEMPERATURE=0.2

# Optional: Directory Paths (override defaults)
# PROJECT_ROOT=/path/to/bv-service-delivery
# DATA_DIR=/path/to/data
# TRANSCRIPTS_DIR=/path/to/transcripts
# PROVS_DIR=/path/to/provs

# Microsoft Teams Integration (Optional - for video call transcript extraction)
# Azure AD App Registration: https://portal.azure.com → Azure Active Directory → App registrations
# Required API Permissions: OnlineMeetingTranscript.Read.All, OnlineMeeting.Read.All
# See parent project's TEAMS_SETUP.md for detailed setup instructions

# Azure Application (client) ID from app registration Overview page
AZURE_CLIENT_ID=your-azure-client-id-here

# Azure Client secret value (from Certificates & secrets)
# Important: Copy secret immediately after creation - it won't be shown again
AZURE_CLIENT_SECRET=your-azure-client-secret-here

# Azure Directory (tenant) ID from app registration Overview page
AZURE_TENANT_ID=your-azure-tenant-id-here

# ============================================================================
# Microsoft Teams Bot Framework Integration (NEW - for Teams chat interface)
# ============================================================================
# Register Azure Bot Service: https://portal.azure.com → Create → Azure Bot
# See TEAMS_DEPLOYMENT.md for complete setup instructions

# Microsoft App ID from Azure Bot Service
# Found in: Azure Portal → Your Bot → Configuration
MICROSOFT_APP_ID=your-azure-bot-app-id-here

# Microsoft App Password (Client Secret)
# Created in: Azure Portal → Your Bot → Configuration → Manage → Certificates & secrets
# Important: Copy the VALUE immediately after creation - shown only once
MICROSOFT_APP_PASSWORD=your-azure-bot-client-secret-here

# App Type: MultiTenant (default) or SingleTenant
# MultiTenant: Bot can be used in any Teams organization
# SingleTenant: Bot restricted to your organization only
MICROSOFT_APP_TYPE=MultiTenant

# Tenant ID (Required only for SingleTenant apps)
# Same as AZURE_TENANT_ID above
# MICROSOFT_APP_TENANTID=your-azure-tenant-id-here

# Bot Server Configuration
# Port for Teams bot server (default: 3978)
BOT_ENDPOINT_PORT=3978

# Host for Teams bot server (default: 0.0.0.0 for all interfaces)
BOT_ENDPOINT_HOST=0.0.0.0
